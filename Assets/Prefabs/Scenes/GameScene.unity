  m_Script: {fileID: 11500000, guid: ae4a9c490a159d2409087405bcff01f0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  title: "\uD0C0\uAC9F\uD305 \uC2A4\uD0AC"
  body: "\uAC8C\uC774\uC9C0\uAC00 \uAC00\uB4DD \uCC28\uBA74 \uC6B0\uD074\uB9AD\uC744 \uB204\uB974\uACE0 \uC788\uB294 \uB3D9\uC548 \uC2DC\uAC04\uC774 \uB290\uB824\uC9C0\uBA70 \uC8FC\uBCC0 \uC801\uC744 \uCC28\uB840\uB85C \uC870\uC900\uD569\uB2C8\uB2E4.\n\uBC84\uD2BC\uC744 \uB5BC\uBA74 \uC870\uC900\uD55C \uBAA8\uB4E0 \uC801\uC5D0\uAC8C \uC77C\uC81C \uC0AC\uACA9!\n\n\uC77C\uBC18 \uC0AC\uACA9\uC73C\uB85C \uC801\uC744 \uB9DE\uD788\uBA74 \uAC8C\uC774\uC9C0\uAC00 \uCC39\uB2C8\uB2E4."
